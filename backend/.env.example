ENVIRONMENT=development

# SECURITY: في الإنتاج يجب أن يكون مفتاحاً عشوائياً بطول 32 حرفاً على الأقل.
# على Render استخدم خيار Generate. يرفض الخادم العمل في الإنتاج بمفتاح ضعيف.
SECRET_KEY=replace-with-a-long-random-production-secret

# اتركه فارغاً للعمل على ملف data.json محلياً.
# في الإنتاج: Supabase Dashboard -> Connect -> Session pooler ثم ضع الرابط هنا.
# يجب أن يبقى sslmode=require.
DATABASE_URL=

# مفتاح مستند الحالة داخل جدول kv_store — لا تغيّره حتى تحافظ على بيانات الإنتاج.
STATE_KEY=housing_state_v1

# الملفات المحلية (نسبة إلى مجلد backend)
DATA_FILE=data.json
SEED_FILE=seed.json

ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
FORCE_PASSWORD_CHANGE=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3444,http://127.0.0.1:3444
MAX_UPLOAD_MB=25
AUDIT_LIMIT=8000
